# ─────────────────────────────────────────────────────────────────
# Pick-Am — Environment Variables Template
# ─────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your real values.
# NEVER commit .env — it is git-ignored for security.
# ─────────────────────────────────────────────────────────────────

# Supabase (https://supabase.com/dashboard → Settings → API)
REACT_APP_SUPABASE_URL=https://your-project-ref.supabase.co
REACT_APP_SUPABASE_ANON_KEY=your-anon-public-key-here

# Paystack (https://dashboard.paystack.com → Settings → API Keys)
# Use pk_test_... for development, pk_live_... for production
REACT_APP_PAYSTACK_PUBLIC_KEY=pk_test_your-public-key-here
